<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.ktestify</groupId>
        <artifactId>ktestify-parent</artifactId>
        <version>1.0.4-SNAPSHOT</version>
    </parent>
    <artifactId>ktestify-plugin-archetype</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <packaging>maven-archetype</packaging>
    <name>ktestify-plugin-archetype</name>
    <description>Maven archetype for generating ktestify plugin projects</description>
    <url>https://github.com/ktestify/ktestify-plugin-archetype</url>
    <inceptionYear>2026</inceptionYear>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>nil-malh</id>
            <name>Nil MALHOMME</name>
            <email>malhomme.nil+oss@icloud.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git://github.com/ktestify/ktestify-plugin-archetype.git</connection>
        <developerConnection>scm:git:ssh://github.com:ktestify/ktestify-plugin-archetype.git</developerConnection>
        <url>https://github.com/ktestify/ktestify-plugin-archetype/tree/main</url>
    </scm>
    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/ktestify/ktestify-plugin-archetype/issues</url>
    </issueManagement>
    <build>
        <extensions>
            <extension>
                <groupId>org.apache.maven.archetype</groupId>
                <artifactId>archetype-packaging</artifactId>
                <version>${maven.archetype.plugin.version}</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-archetype-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
